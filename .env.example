# Anthropic — used for expert selection, PRD reviews, and replies
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — used for user auth state and free query quota tracking
SUPABASE_PASSWORD=your-supabase-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth — sign-in provider (configure at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# NextAuth — session secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret
